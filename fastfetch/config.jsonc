{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto",
    },

    "display": {
        "separator": ": ",
    },

    "modules": [
        {
            "type": "custom",
            "format": "\u001b[34m┌──────────────────────Hardware──────────────────────┐",
            "color": "blue",
        },
        {
            "type": "host",
            "key": "󰌢 PC ",
            "format": "{name}",
            "keyColor": "blue",
        },
        {
            "type": "cpu",
            "key": "│ ├ ",
            "format": "{name}",
            "keyColor": "blue",
        },
        {
            "type": "gpu",
            "key": "│ ├󰾲 ",
            "format": "{name}",
            "keyColor": "blue",
        },
        {
            "type": "memory",
            "key": "│ ├ ",
            "format": "{used} / {total}",
            "keyColor": "blue",
        },
        {
            "type": "disk",
            "key": "│ ├ ",
            "format": "{size-used} / {size-total}",
            "keyColor": "blue",
        },

        {
            "type": "custom",
            "format": "\u001b[34m└────────────────────────────────────────────────────┘",
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[32m┌──────────────────────Software──────────────────────┐",
        },
        {
            "type": "os",
            "key": " OS ",
            "format": "{name}",
            "keyColor": "green",
        },
        {
            "type": "shell",
            "key": "│ ├ ",
            "format": "{process-name}",
            "keyColor": "green",
        },
        {
            "type": "kernel",
            "key": "│ ├ ",
            "format": "{sysname} {release}",
            "keyColor": "green",
        },
        {
            "type": "wm",
            "key": "│ ├ ",
            "format": "{process-name} ({protocol-name})",
            "keyColor": "green",
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 ",
            "format": "pacman: {pacman} | Flatpack: {flatpak-all}",
            "keyColor": "green",
        },
	{
	    "type": "terminalfont",
	    "key": "│ ├" ,
	    "keyColor": "green",
	},
        {
            "type": "custom",
            "format": "\u001b[32m└────────────────────────────────────────────────────┘",
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m┌──────────────────────Age/Uptime────────────────────┐",
        },
        {
            "type": "command",
            "key": "│ > OS Age ",
            "keyColor": "blue",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
        },
        {
            "type": "uptime",
            "key": "│ >  ",
            "keyColor": "blue",
        },
        {
            "type": "custom",
            "format": "\u001b[34m└────────────────────────────────────────────────────┘",
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle",
        },
    ],
}
