{
    "project_panel": {
        "dock": "right",
    },
    "icon_theme": {
        "dark": "Colored Zed Icons Theme Dark",
        "light": "Colored Zed Icons Theme Light",
    },
    "ui_font_size": 16,
    "ui_font_family": "SF Pro",
    "buffer_font_family": "JetBrainsMonoNL Nerd Font",
    "buffer_font_weight": 400,
    "buffer_font_size": 17,
    "buffer_line_height": "comfortable",
    "theme": {
        "mode": "system",
        "light": "Aizen Light",
        "dark": "Aizen Dark",
    },
    "disable_ai": true,
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },
    "format_on_save": "on",
    "toolbar": {
        "breadcrumbs": false,
        "agent_review": false,
        "code_actions": false,
        "quick_actions": false,
    },
    "tab_size": 4,
    "preferred_line_length": 110,
}
