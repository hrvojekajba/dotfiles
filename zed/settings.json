{
  "project_panel": {
    "dock": "right",
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "ui_font_family": "Noto Sans",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_weight": 500,
  "buffer_font_size": 17,
  "buffer_line_height": "comfortable",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Mirage",
  },
  "disable_ai": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "format_on_save": "on",
  "toolbar": {
    "breadcrumbs": false,
    "agent_review": false,
    "code_actions": false,
    "quick_actions": false,
  },
}
