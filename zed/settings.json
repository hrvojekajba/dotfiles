{
  "project_panel": {
    "dock": "right",
  },
  "icon_theme": {
    "dark": "JetBrains New UI Icons (Dark)",
    "light": "JetBrains New UI Icons (Light)",
  },
  "ui_font_size": 16,
  "ui_font_family": "SF Pro",
  "buffer_font_family": "SFMono Nerd Font",
  "buffer_font_weight": 500,
  "buffer_font_size": 17,
  "buffer_line_height": "comfortable",
  "theme": {
    "mode": "system",
    "light": "JetBrains Light",
    "dark": "JetBrains Dark",
  },
  "disable_ai": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "format_on_save": "on",
  "toolbar": {
    "breadcrumbs": false,
    "agent_review": false,
    "code_actions": false,
    "quick_actions": false,
  },
}
